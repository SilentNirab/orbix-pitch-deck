    },
    {
      "@type": "CreativeWork",
      "@id": "http://127.0.0.1:5188/read/#slide-54",
      "position": 54,
      "name": "Strategy & brand pricing",
      "text": "Orbix Studio\nProduct × Design × Growth\nStrategy & \nResearch\nProduct Strategy & Positioning\nUX Research & Architecture\nProduct Audit & Optimization\n$15K – $40K\n$12K – $35K\nCustom Scope\nVisual Identity Systems\n$20K – $60K\n$15K – $45K\n$40K+\nBrand Strategy\nBrand \nSystems\nFull Brand & Product \nAlignment Program",
      "url": "http://127.0.0.1:5188/read/#slide-54",
