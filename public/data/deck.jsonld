      }
    },
    {
      "@type": "CreativeWork",
      "@id": "http://127.0.0.1:5188/read/#slide-55",
      "position": 55,
      "name": "Design & development pricing",
      "text": "Product × Design × Growth\nUX & Interface \nDesign\nDevelopment \nSupport\nOrbix Studio\nSaaS Product Design (MVP)\nEnterprise Product Systems\nDesign System Development\n$18K – $50K\n$30K – $90K\n$60K – $150K+\n$20K – $55K\nMarketing Website Design\nCMS & Website Development\n$25K – $120K\n$20K – $70K\nCustom Scope\nFrontend Implementation \n(Product)\nCMS & Website Development",
      "url": "http://127.0.0.1:5188/read/#slide-55",
