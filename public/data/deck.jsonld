    },
    {
      "@type": "CreativeWork",
      "@id": "http://127.0.0.1:5188/read/#slide-53",
      "position": 53,
      "name": "Service pricing ranges",
      "text": "Product × Design × Growth\nService Pricing \nRanges\nEvery project is different. Our pricing \nranges reflect the work involved, from \nfocused design projects to complete \nproduct development.\nR\na\nn\ng\ne\nOrbix Studio",
      "url": "http://127.0.0.1:5188/read/#slide-53",
      "image": "http://127.0.0.1:5188/assets/slides/53.webp",
