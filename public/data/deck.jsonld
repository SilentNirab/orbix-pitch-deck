    },
    {
      "@type": "CreativeWork",
      "@id": "http://127.0.0.1:5188/read/#slide-56",
      "position": 56,
      "name": "How we work",
      "text": "Product × Design × Growth\nAverage Hourly Rate\n$50  – $99 / hour\nDepending on specialization and scope\nHow We Work\nEvery engagement starts with your goals, scope, and priorities. \nWe focus on delivering meaningful results, building products that \ncan grow, and making the most of your investment.\n\n\n\nOrbix Studio",
      "url": "http://127.0.0.1:5188/read/#slide-56",
      "image": "http://127.0.0.1:5188/assets/slides/56.webp",
