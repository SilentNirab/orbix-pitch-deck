      "position": 1,
      "name": "Company deck",
      "text": "Company\nDeck\nOrbix Studio\nEurope\nDesign\n©2026\n10+ YEARS OF\nDESIGN EXPERIENCE\nSTRATEGY — UI/UX \nDEVELOPMENT\nOrbix Studio",
      "url": "http://127.0.0.1:5188/read/#slide-1",
      "image": "http://127.0.0.1:5188/assets/slides/01.webp",
      "isPartOf": {
