{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://127.0.0.1:5188/data/deck.schema.json",
  "title": "Orbix Studio pitch deck",
  "description": "Preserved source copy and stable slide references.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "language",
    "website",
    "sourceUrl",
    "slideCount",
    "sections",
    "slides"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "title": {
      "type": "string"
    },
    "language": {
      "const": "en"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri"
    },
    "slideCount": {
      "type": "integer",
      "minimum": 1
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slide"
      }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "slideCount",
        "slideIds",
        "readUrl"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^section-[a-z0-9-]+$"
        },
        "title": {
          "type": "string"
        },
        "slideCount": {
          "type": "integer",
          "minimum": 1
        },
        "readUrl": {
          "type": "string",
          "format": "uri"
        },
        "slideIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "section",
        "text",
        "textAvailability",
        "sourcePage",
        "viewerUrl",
        "readUrl",
        "image",
        "thumbnail",
        "width",
        "height"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "textAvailability": {
          "enum": [
            "extracted",
            "visual-only"
          ]
        },
        "sourcePage": {
          "type": "integer",
          "minimum": 1
        },
        "viewerUrl": {
          "type": "string",
          "format": "uri"
        },
        "readUrl": {
          "type": "string",
          "format": "uri"
        },
        "image": {
          "type": "string",
          "format": "uri"
        },
        "thumbnail": {
          "type": "string",
          "format": "uri"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
